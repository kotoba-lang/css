(ns css-document
  ;; No :export: parity harness appends zero-arg case defns and executes them
  ;; via KIR. Schemas alone enable record-new/get.
  ;;
  ;; T5.2 note: only closed-profile field types can live in guest records.
  ;; `:document` is outside the closed profile, so rule-doc (selector+decls)
  ;; and render-decls (decls+i+n+acc) stay multi-arg until document-in-record
  ;; lands. decl (keyword+string) folds cleanly.
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :doc/decl [:record :doc/decl
                        [[:prop :keyword] [:value :string]]]}))

;; Delivery 6 first cutover slice for the design system (ADR-2607279200 /
;; ADR-2607270100 §10 / migration plan W6):
;;
;; A *logical style document* is an ordinary `:document` value
;; (`:selector` + `:decls` vector of `:prop`/`:value` maps) — the Style half
;; of W4 Document/Style fixtures — not a host object and not a form-A
;; call-graph of strings only. Rendering to a CSS *stream* is pure guest
;; recursion over that document.
;;
;; Form-A (`css_core.kotoba`, typed-map keyword→string) remains the oracle
;; for declaration text; this module must byte-agree with it (and with a
;; key-sorted css.core run) for the same rule corpus. Consumers keep using
;; css.core; this is the logical-value authority path design-system
;; cutover will promote once html/shitsuke/... follow.
;;
;; Capability-free (kotoba/pure). Handles are not the application model.
;; T5.2: decl multi-arg folded into guest record; rule-doc/render-decls blocked
;; on :document-in-record (closed profile).

;; --- breakout guard (same four sequences as form-A / css.core) ------------

(defn safe? [s :string] :bool
  (if (string-contains? s "{") false
      (if (string-contains? s "}") false
          (if (string-contains? s ";") false
              (if (string-contains? s "/*") false true)))))

;; --- document constructors ------------------------------------------------

(defn decl [x [:ref :doc/decl]] :document
  ;; T5.2: prop+value on one guest record
  (let [prop (record-get x :prop)
        value (record-get x :value)]
    (document-map :prop (document-keyword prop)
                  :value (document-string value))))

(defn rule-doc [selector :string decls :document] :document
  ;; Multi-arg retained: :document not allowed in guest record schema
  ;; (closed profile). See ns comment / Progress ADR.
  (document-map :selector (document-string selector)
                :decls decls))

;; --- render logical style document → CSS stream ---------------------------

(defn prop-of [d :document] :string
  (keyword-name
   (option-value-of [:option :keyword]
     (document-keyword-value
       (option-value-of [:option :document]
         (document-get d :prop) (document-null)))
     :missing)))

(defn value-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :value) (document-null)))
    ""))

(defn sel-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :selector) (document-null)))
    "*"))

(defn decls-of [d :document] :document
  (option-value-of [:option :document]
    (document-get d :decls) (document-vector)))

(defn render-decl [d :document] [:result :string :string]
  (if (safe? (value-of d))
    (result-ok-of [:result :string :string]
                  (string-concat (prop-of d)
                                 (string-concat ": " (string-concat (value-of d) ";"))))
    (result-err-of [:result :string :string]
                   (string-concat "unsafe value for " (prop-of d)))))

(defn render-decls [decls :document i :i64 n :i64 acc :string]
  [:result :string :string]
  ;; Multi-arg retained: decls is :document (outside closed record profile).
  (if (>= i n)
    (result-ok-of [:result :string :string] acc)
    (match-result
     (render-decl (option-value-of [:option :document]
                    (document-vector-at decls i) (document-null)))
     [:result :string :string]
     (ok text
         (render-decls decls (+ i 1) n
                       (if (string=? acc "")
                         text
                         (string-concat acc (string-concat " " text)))))
     (err message (result-err-of [:result :string :string] message)))))

(defn render-rule [d :document] [:result :string :string]
  (if (safe? (sel-of d))
    (match-result
     (render-decls (decls-of d) 0 (document-count (decls-of d)) "")
     [:result :string :string]
     (ok body
         (result-ok-of [:result :string :string]
                       (string-concat (sel-of d)
                                      (string-concat " { "
                                                     (string-concat body " }")))))
     (err message (result-err-of [:result :string :string] message)))
    (result-err-of [:result :string :string] "unsafe selector")))

;; --- identity helpers (W4 print/sha256 surface) ---------------------------

(defn rule-digest [d :document] :string
  (document-sha256 d))

(defn rule-print [d :document] :string
  (document-print d))

(defn rule-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (result-value-of [:result :string :string]
                    (render-rule
                     (rule-doc ".card"
                               (document-vector
                                (decl (record-new [:ref :doc/decl]
                                                  :color "#fff"))
                                (decl (record-new [:ref :doc/decl]
                                                  :padding "16px")))))
                    "")))
